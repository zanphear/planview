# Planview, Production Environment (TEMPLATE)
# Copy this to deploy/.env.production (gitignored) and fill in real values.
# Generate a strong JWT secret with:  openssl rand -base64 64

# --- Required ---
JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_base64_64

# --- Database ---
POSTGRES_USER=planview
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=planview

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- CORS (set to your actual domain when exposing externally) ---
CORS_ORIGINS=http://localhost

# --- Nginx port ---
NGINX_PORT=80

# --- AI Model (optional, leave empty to disable) ---
AI_MODEL_URL=
AI_MODEL_NAME=

# --- Auth mode: password | hybrid | oidc_only ---
AUTH_MODE=password

# --- OIDC / SSO (optional, configure for PocketID etc.) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=regular

# --- Swagger docs (disabled in production) ---
ENABLE_DOCS=false
