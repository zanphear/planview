# Planview — Production Environment
# Copy this to .env in the Dockge stack dir

# --- Required ---
JWT_SECRET_KEY=e_fA3kTM05KRk1aLZ4vlyMoK0qymDTMa89BhXKXUpCeerxhYPbTwal57FGteiyfBsN9KI-JwOsSL4kU04XhW8A

# --- Database ---
POSTGRES_USER=planview
POSTGRES_PASSWORD=planview_secret
POSTGRES_DB=planview

# --- Redis ---
REDIS_PASSWORD=planview_redis_secret

# --- CORS (set to your actual domain when exposing externally) ---
CORS_ORIGINS=http://localhost

# --- Nginx port ---
NGINX_PORT=80

# --- AI Model (optional — leave empty to disable) ---
AI_MODEL_URL=http://192.168.0.53:8003/v1
AI_MODEL_NAME=Qwen3-Coder-Next-MXFP4_MOE_F16.gguf

# --- Auth mode: password | hybrid | oidc_only ---
AUTH_MODE=password

# --- OIDC / SSO (optional — configure for PocketID etc.) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_AUTO_PROVISION=true
OIDC_DEFAULT_ROLE=regular

# --- Swagger docs (disabled in production) ---
ENABLE_DOCS=false
